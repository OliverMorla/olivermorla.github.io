# Every environment variable the site reads. Real values live in Vercel;
# pull them locally with `vercel env pull .env.local`. Never commit secrets.

# --- Database & CMS (Payload) ---------------------------------------------
# Postgres shared by Payload and Better Auth (auth tables are prefixed auth_).
DATABASE_URI=postgres://user:password@host:5432/dbname
PAYLOAD_SECRET=
# Comma-separated emails allowed into the Payload admin.
PAYLOAD_ADMIN_EMAIL_LIST=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Media storage (S3-compatible).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth (Better Auth, /auth/login and /dashboard) -------------------------
# At least 32 random characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The site's canonical URL. On Vercel previews it falls back to VERCEL_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Product analytics (PostHog, browser) -----------------------------------
# Project API key (public, phc_...). Capture only runs in production builds.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to "true" to send events from `next dev` (e.g. to test an event).
NEXT_PUBLIC_POSTHOG_CAPTURE_DEV=

# --- Dashboard data (PostHog query API, server only) -----------------------
# Personal API key (phx_...) with the "Query Read" scope. Secret: never
# prefix it NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
# Hosts counted as real traffic (comma-separated).
ANALYTICS_SITE_HOSTS=www.olivermorla.com,olivermorla.com

# --- Other services ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=
# Spelled ARKJET in the deployed environment.
ARKJET_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
