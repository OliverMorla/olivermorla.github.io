# Every environment variable the site reads. Real values live in Vercel;
# pull them locally with `vercel env pull .env.local`. Never commit secrets.

# --- Database & CMS (Payload) ---------------------------------------------
# Postgres shared by Payload and Better Auth (auth tables are prefixed auth_).
# DATABASE_URL is Supabase's pooled connection and is preferred; DIRECT_URL
# (the direct connection) is used when it's missing.
DATABASE_URL=postgres://user:password@host:6543/dbname
DIRECT_URL=postgres://user:password@host:5432/dbname
PAYLOAD_SECRET=
# Comma-separated emails allowed into the Payload admin.
PAYLOAD_ADMIN_EMAIL_LIST=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Media storage (S3-compatible).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth (Better Auth, /auth/login and /dashboard) -------------------------
# At least 32 random characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The site's canonical URL. On Vercel previews it falls back to VERCEL_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Private AI chat (/dashboard/chat, server only) -------------------------
# OpenAI-compatible base URL of LM Studio. Locally: http://localhost:1234/v1
LLM_API_BASE_URL=https://llm.olivermorla.com/v1
# Cloudflare Access service token for llm.olivermorla.com. Leave both empty
# locally. Secret: never prefix NEXT_PUBLIC_.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Model ids users may pick (comma-separated, as LM Studio reports them).
# The first one is the default.
LLM_ALLOWED_MODELS=

# --- Product analytics (PostHog, browser) -----------------------------------
# Project API key (public, phc_...). Capture only runs in production builds.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to "true" to send events from `next dev` (e.g. to test an event).
NEXT_PUBLIC_POSTHOG_CAPTURE_DEV=

# --- Dashboard data (PostHog query API, server only) -----------------------
# Personal API key (phx_...) with the "Query Read" scope. Secret: never
# prefix it NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
# Hosts counted as real traffic (comma-separated).
ANALYTICS_SITE_HOSTS=www.olivermorla.com,olivermorla.com

# --- Other services ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=
ARCJET_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
